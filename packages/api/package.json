{
  "name": "@couchpick/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 execute couchpick-db --remote --file=./drizzle/migrations/0000_initial.sql",
    "db:studio": "wrangler d1 execute couchpick-db --local --command \"SELECT 1\""
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "drizzle-kit": "^0.28.0",
    "wrangler": "^4"
  }
}

{
  "name": "couchpick",
  "private": true,
  "version": "0.1.0",
  "description": "Biblioteca personal de contenido (watchlist + shuffle) — CouchPick",
  "scripts": {
    "dev:api": "npm run dev -w @couchpick/api",
    "dev:web": "npm run dev -w @couchpick/web",
    "build": "npm run build -w @couchpick/web",
    "build:api": "npm run deploy -w @couchpick/api",
    "build:web": "npm run build -w @couchpick/web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "clean": "rimraf node_modules packages/api/node_modules packages/web/node_modules",
    "infra:init": "cd terraform && terraform init",
    "infra:plan": "cd terraform && terraform plan",
    "infra:apply": "cd terraform && terraform apply"
  },
  "workspaces": ["packages/*"],
  "overrides": {
    "rollup-plugin-node-polyfills": "git+https://github.com/ionic-team/rollup-plugin-node-polyfills.git"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "rimraf": "^6.0.1",
    "rollup-plugin-node-polyfills": "git+https://github.com/ionic-team/rollup-plugin-node-polyfills.git"
  }
}
